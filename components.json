{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@kibo-ui": "https://www.kibo-ui.com/registry/{name}.json",
    "@pureui": "https://pureui.xyz/r/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@bundui": "https://bundui.io/r/{name}.json"
  }
}
